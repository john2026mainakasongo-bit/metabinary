# MetaBinary Server Configuration Example
PORT=5000
MONGODB_URI=mongodb://localhost:27107/metabinary
MONGODB_DB=metabinary
JWT_SECRET=your_jwt_signing_secret_key_at_least_24_chars

# M-PESA Daraja
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=your_consumer_key
DARAJA_CONSUMER_SECRET=your_consumer_secret
DARAJA_PASSKEY=your_passkey
DARAJA_SHORTCODE=174379
DARAJA_TILL_NUMBER=174379
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
DARAJA_CALLBACK_URL=https://your-backend.example.com/api/mpesa/callback

# Pesapal and email
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=your_key
PESAPAL_CONSUMER_SECRET=your_secret
PESAPAL_IPN_ID=your_ipn_id
RESEND_API_KEY=your_resend_key
PASSWORD_RESET_FROM_EMAIL=MetaBinary <noreply@example.com>

# Admin (use a long unique password)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_long_unique_password

# Platform Parameters
USD_RATE=130
MIN_DEPOSIT_USD=1
MIN_WITHDRAW_USD=5
MAX_WITHDRAW_USD=150000
MAX_REAL_STAKE_USD=25
MAX_REAL_DAILY_STAKE_USD=1000
MAX_OPEN_REAL_TRADES=3
REAL_TRADE_COOLDOWN_MS=2500
SIMULATE_PAYMENTS=false

# Client Configuration
FRONTEND_URL=http://localhost:5173
PUBLIC_BACKEND_URL=http://localhost:5000
FRONTEND_PUBLIC_URL=http://localhost:5173
TWELVE_DATA_API_KEY=your_twelve_data_key
